    "password": null
  },
  "influxdb": {
    "enabled": true,
    "url": "http://localhost:8086",
    "token": "your-influxdb-token-here",
    "org": "your-organization",
    "bucket": "predictions",
    "measurement": "ml_predictions"
  }
